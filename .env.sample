# Copy to .env for local development (loaded by .envrc / dotenvy).
# In production these are provided by the NixOS module:
#   - non-secret values via systemd Environment=
#   - secrets via systemd LoadCredential, surfaced as *_FILE paths.

# --- Cloudflare Workers AI (required) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternatively point at a file holding the token (takes precedence):
# CLOUDFLARE_API_TOKEN_FILE=/path/to/token
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_TIMEOUT_SECS=300

# --- Slack (required) ---
SLACK_BOT_TOKEN=
# SLACK_BOT_TOKEN_FILE=/path/to/token
# SLACK_CHANNEL=#general
# SLACK_USERNAME=Hacker News Summarizer

# --- Article selection (optional) ---
# ARTICLE_COUNT=3

# --- State (optional) ---
# Path to the SQLite dedup store. Defaults to $STATE_DIRECTORY/state.db
# (set by systemd) or ./state.db when run locally.
# STATE_DB_PATH=./state.db

# --- Logging (optional) ---
# RUST_LOG=info
